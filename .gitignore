# Build output
*.o
*.a
*.so
*.elf
*.bin
build/
out/
dist/

# Pinned build input: the ps5-opengl SDK and the link group written beside it,
# both regenerated by tools/fetch-opengl-sdk.sh and tools/prepare-opengl.sh.
third_party/ps5-opengl/

# Same for the JSON parser core/json.cpp reads: fetched at a pinned commit by
# tools/fetch-yyjson.sh (see the header of that script for the version).
third_party/yyjson/

# And for the decompressor core/zlib_stream.cpp reads: fetched at a pinned
# release by tools/fetch-zlib.sh, which checks it against the sha256 zlib.net
# publishes.
third_party/zlib/

# macOS
.DS_Store

# Local config / secrets — never commit tokens
.env
token*
*.token
